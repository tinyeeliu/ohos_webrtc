      "../../modules/video_coding:webrtc_vp8",
      "../../modules/video_coding:webrtc_vp9",
      "../../modules/video_coding/codecs/av1:libaom_av1_encoder",
      "../../modules/video_coding/codecs/av1:dav1d_decoder",
      "../../rtc_base:checks",
      "//third_party/libyuv",
    ]

    output_extension = "so"
  }

