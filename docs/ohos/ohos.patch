+#define LOG_ON_ERROR(op)                                                      \
+    do {                                                                        \
+        OH_AudioStream_Result result = (op);                                            \
+        if (result != AUDIOSTREAM_SUCCESS) {                                                \
+            RTC_LOG(LS_ERROR) << #op << ": " << "NOK"; \
+        }                                                                         \
